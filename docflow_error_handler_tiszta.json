    {
      "parameters": {
        "jsCode": "// Error Handler - Audit Logger\n// Input schema:  Error Trigger kimenet { execution, workflow }\n// Output schema: { task, inputs, actions, risks, result }\n\nconst e = $input.first().json;\n\nconst audit = {\n  task: `Unhandled error in workflow: ${e.workflow?.name ?? \"unknown\"}`,\n  inputs: [],  // szándékosan üres: payload/PII nem kerül a naplóba\n  actions: [\n    `Failed node: ${e.execution?.lastNodeExecuted ?? \"unknown\"}`,\n    `Execution ID: ${e.execution?.id ?? \"unknown\"}`,\n  ],\n  risks: [e.execution?.error?.message ?? \"No error message\"],\n  result: \"failed\",\n  timestamp: new Date().toISOString(),\n};\n\nreturn [{ json: audit }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
