    {
      "parameters": {
        "jsCode": "// DocFlow Ingestion & Parsing - Payload Validator\n// Input schema:  { id: string|number, data: object|array } (Webhook esetén a body alatt)\n// Output schema: { ...payload, _validation: { valid: boolean, errors: string[] } }\n\nconst validItems = [];\nconst rejectedItems = [];\n\nconst allItems = $input.all();\n\n// Batch szintű ellenőrzés: legyen tömb és ne legyen üres\nif (!Array.isArray(allItems) || allItems.length === 0) {\n  throw new Error(\"Validation Error: Empty or non-array batch rejected.\");\n}\n\nfor (const item of allItems) {\n  // Webhook node esetén a payload a .body alatt van, egyébként közvetlenül a .json-ban\n  const payload = item.json.body ?? item.json;\n  const errors = [];\n\n  if (payload === null || typeof payload !== \"object\" || Array.isArray(payload)) {\n    errors.push(\"Payload must be a JSON object\");\n  } else {\n    if (payload.id === undefined || payload.id === null || payload.id === \"\") {\n      errors.push(\"Missing required field: id\");\n    }\n    if (payload.data === undefined || payload.data === null) {\n      errors.push(\"Missing required field: data\");\n    } else if (![\"object\", \"string\"].includes(typeof payload.data)) {\n      errors.push(\"Field 'data' must be a string, object or array\");\n    }\n  }\n\n  if (errors.length === 0) {\n    validItems.push({ json: { ...payload, _validation: { valid: true, errors: [] } } });\n  } else {\n    // Audit-barát: csak a hibakategória és az id kerül ki, PII/secret nem\n    rejectedItems.push({\n      json: {\n        id: payload?.id ?? null,\n        _validation: { valid: false, errors },\n      },\n    });\n  }\n}\n\n// Érvényes elemek mennek tovább, a hibásak a végén, jelölve\nreturn [...validItems, ...rejectedItems];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "efd2ef24-e7f9-4db7-bb0e-7a07f9f2e72f",
      "name": "Payload Validator"
    },
    {
      "parameters": {
        "jsCode": "// DocFlow Transformation & Logic - Data Mapper\n// Input schema:  { id: string|number, data: string|object|array, source?: string, _validation: {...} }\n// Output schema: { id: string, data: <ugyanolyan típus, tisztítva>, metadata: { processedAt, sourceSystem, version } }\n\n// Rekurzív tisztítás: a szövegekből eltávolítja a <, > karaktereket, a struktúrát megtartja\nfunction sanitize(value) {\n  if (typeof value === 'string') {\n    return value.trim().replace(/[<>]/g, '');\n  }\n  if (Array.isArray(value)) {\n    return value.map(sanitize);\n  }\n  if (value !== null && typeof value === 'object') {\n    return Object.fromEntries(\n      Object.entries(value).map(([k, v]) => [k, sanitize(v)])\n    );\n  }\n  return value; // szám, boolean, null változatlan\n}\n\nconst outputItems = [];\n\nfor (const item of $input.all()) {\n  const rawData = item.json;\n\n  const cleanedId = String(rawData.id).trim();\n  const formattedData = sanitize(rawData.data ?? '');\n\n  const processedItem = {\n    id: cleanedId,\n    data: formattedData,\n    metadata: {\n      processedAt: new Date().toISOString(),\n      sourceSystem: rawData.source || 'external_webhook',\n      version: '1.0.0',\n    },\n  };\n\n  outputItems.push({ json: processedItem });\n}\n\nreturn outputItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
