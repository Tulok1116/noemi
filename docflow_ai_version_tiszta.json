    {
      "parameters": {
        "jsCode": "// AI Enrichment Validator\n// Input schema:  LLM Chain kimenet { output | text }\n// Output schema: { id, data, metadata, enrichment: { category, priority, summary, confidence, status, needsReview } }\n\nconst CATEGORIES = [\"order\", \"support\", \"invoice\", \"complaint\", \"spam\", \"other\"];\nconst PRIORITIES = [\"low\", \"medium\", \"high\"];\n\nreturn $input.all().map((item, i) => {\n  const original = $('Data Mapper').itemMatching(i).json;\n\n  let ai = item.json.output ?? item.json.text ?? null;\n  if (typeof ai === \"string\") {\n    try { ai = JSON.parse(ai); } catch { ai = null; }\n  }\n\n  const errors = [];\n  if (!ai || typeof ai !== \"object\") {\n    errors.push(\"AI output is not a valid object\");\n  } else {\n    if (!CATEGORIES.includes(ai.category)) errors.push(\"Invalid category\");\n    if (!PRIORITIES.includes(ai.priority)) errors.push(\"Invalid priority\");\n    if (typeof ai.summary !== \"string\" || ai.summary.trim() === \"\") errors.push(\"Missing summary\");\n    if (typeof ai.confidence !== \"number\" || ai.confidence < 0 || ai.confidence > 1) errors.push(\"Invalid confidence\");\n  }\n\n  const enrichment = errors.length === 0\n    ? {\n        category: ai.category,\n        priority: ai.priority,\n        summary: ai.summary.trim().slice(0, 300),\n        confidence: ai.confidence,\n        status: \"classified\",\n        needsReview: ai.confidence < 0.6,\n      }\n    : { category: \"unclassified\", priority: \"medium\", summary: \"\", confidence: 0, status: \"fallback\", needsReview: true, errors };\n\n  return { json: { ...original, enrichment } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1296,
        -400
      ],
      "id": "6847a0f7-a99b-46bc-8dd8-0827a2ca6654",
      "name": "AI Enrichment Validator"
    },
