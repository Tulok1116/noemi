    {
      "parameters": {
        "jsCode": "// Audit Logger (közös: validációs elutasítás + AI hiba)\n// Input A: { id, _validation: { valid: false, errors: string[] } }\n// Input B: LLM Chain hibakimenet { ...bemeneti mezők, error }\n// Output: { id, httpStatus, status, publicErrors, audit: { task, inputs, actions, risks, result, timestamp } }\n\nreturn $input.all().map(item => {\n  const j = item.json;\n  const isValidation = j._validation && j._validation.valid === false;\n\n  let httpStatus, status, task, actions, risks, publicErrors;\n\n  if (isValidation) {\n    httpStatus = 400;\n    status = \"rejected\";\n    task = \"Payload validation\";\n    actions = [\"Payload rejected by validator\"];\n    risks = j._validation.errors ?? [];\n    publicErrors = risks;\n    } else {\n    const msg = typeof j.error === \"string\" ? j.error :     (j.error?.message ?? \"Unknown error\");\n    const fromExternalApi = j.enrichment !== undefined; // ha már volt AI besorolás, a HTTP Request hibázott\n    httpStatus = 502;\n    status = fromExternalApi ? \"external_api_failed\" : \"ai_failed\";\n    task = fromExternalApi ? \"External API call\" : \"AI enrichment\";\n    actions = [fromExternalApi ? \"HTTP Request failed\" : \"LLM chain failed\"];\n    risks = [msg.slice(0, 200)];\n    publicErrors = [fromExternalApi ? \"Downstream service unavailable\" : \"Enrichment service unavailable\"];\n  }\n\n  return {\n    json: {\n      id: j.id ?? null,\n      httpStatus,\n      status,\n      publicErrors,\n      audit: {\n        task,\n        inputs: [],  // szándékosan üres: payload/PII nem kerül a naplóba\n        actions,\n        risks,\n        result: status,\n        timestamp: new Date().toISOString(),\n      },\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        32
      ],
      "id": "99c98c18-2bac-4066-b82d-9edc5c32602a",
      "name": "Audit Logger"
