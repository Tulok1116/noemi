      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "// Error Handler - Audit Logger\n// Input schema:  Error Trigger output { workflow: { id, name }, execution?: { id, lastNodeExecuted, error: { message } }, trigger?: { error: { message } } }\n// Output schema: { status, httpStatus, workflowName, failedNode, executionId,\n//                  audit: { task, inputs, actions, risks, result, timestamp } }\n// Same audit record shape as the main workflow. No payload, no PII, no secrets, no stack traces.\n\nreturn $input.all().map(item => {\n  const e = item.json;\n  const exec = e.execution ?? {};\n  // Trigger-level failures (e.g. a broken trigger node) arrive under \"trigger\" instead of \"execution\"\n  const rawMessage = exec.error?.message ?? e.trigger?.error?.message ?? \"No error message\";\n\n  const workflowName = e.workflow?.name ?? \"unknown\";\n  const failedNode = exec.lastNodeExecuted ?? \"unknown\";\n  const executionId = String(exec.id ?? \"unknown\");\n\n  return {\n    json: {\n      status: \"unhandled_error\",\n      httpStatus: 500,\n      workflowName,\n      failedNode,\n      executionId,\n      audit: {\n        task: `Unhandled error in workflow: ${workflowName}`,\n        inputs: [],  // intentionally empty: payload/PII is never written to the log\n        actions: [`Failed node: ${failedNode}`, `Execution ID: ${executionId}`],\n        risks: [String(rawMessage).slice(0, 200)],  // truncated, internal detail only\n        result: \"failed\",\n        timestamp: new Date().toISOString(),\n      },\n    },\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        144
      ],
      "id": "368d2535-87be-42cb-861d-66ca1e1a5b34",
      "name": "Error Audit Logger"
    },
